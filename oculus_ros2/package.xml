<?xml version="1.0"?>
<package format="3">
  <name>oculus_ros2</name>
  <version>0.0.1</version>
  <description>ROS 2 nodes for BluePrint subsea Oculus M1200d sonar</description>

  <maintainer email="auguste@forssea-robotics.fr">Auguste BOURGOIS</maintainer>

  <license>BSD3</license>

  <!-- TODO(hugoyvrn, Cleannig in dependency needed) -->
  <depend> ament_cmake </depend>
  <depend> rclcpp </depend>
  <depend> rclpy </depend>
  <depend> rcl_interfaces </depend>
  <depend> std_msgs </depend>
  <depend> sensor_msgs </depend>
  <!-- OpenCV only: cv_bridge is intentionally NOT a dependency (4.5.4 vs 4.8.0 ABI clash
       on the Jetson). See CMakeLists.txt and sonar_viewer.cpp. -->
  <depend> OpenCV </depend>
  <!-- oculus_driver is an external CMake-only library (not a colcon package);
       located via find_package + CMAKE_PREFIX_PATH, not colcon's dependency graph. -->
  <depend> oculus_interfaces </depend>
  <!-- <depend>message_generation</depend> -->
  <!-- <depend>message_runtime</depend> -->
  <!-- <depend>Boost</depend> -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
